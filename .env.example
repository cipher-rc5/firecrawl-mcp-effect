# Firecrawl MCP — Environment Configuration
# Copy to .env.local for local development. Never commit secrets.

# ---- Required (one of these must be set) ----

# Firecrawl cloud API key (obtain from https://firecrawl.dev)
FIRECRAWL_API_KEY=

# Self-hosted Firecrawl instance base URL (e.g. http://localhost:3002)
FIRECRAWL_API_URL=

# ---- Optional ----

# Enable cloud-service mode (requires FIRECRAWL_API_KEY per request via header)
CLOUD_SERVICE=false

# Enable safe mode (disables interactive browser actions). Auto-enabled when CLOUD_SERVICE=true
SAFE_MODE=false

# Maximum accepted MCP request body size in bytes (default 1 MiB)
MAX_REQUEST_BODY_BYTES=1048576

# Per-request processing timeout budget in milliseconds
REQUEST_TIMEOUT_MS=25000

# In-memory fixed-window per-IP rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

# Server port for local / non-Vercel usage
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# MCP protocol version advertised in responses
MCP_VERSION=2024-11-05
